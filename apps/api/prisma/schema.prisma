generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINANCE
  DIVISION_LEADER
}

enum Locale {
  id
  en
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ProjectStatus {
  PLANNED
  ONGOING
  DONE
}

enum FinanceCategoryType {
  INCOME
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  name            String
  role            Role
  isActive        Boolean  @default(true)
  preferredLocale Locale   @default(id)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Inverse relation for Division.leaderUserId
  leadsDivision Division?

  // Activity
  requestedBookings Booking[]      @relation("BookingRequester")
  decidedBookings   Booking[]      @relation("BookingDecider")
  incomeEntries     IncomeEntry[]
  expenseEntries    ExpenseEntry[]
  auditLogs         AuditLog[]
}

model Division {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  photoUrl     String?
  order        Int      @default(0)
  leaderUserId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leader        User?          @relation(fields: [leaderUserId], references: [id], onDelete: SetNull)
  members       Member[]
  projects      Project[]
  bookings      Booking[]
  budgets       Budget[]
  expenseEntries ExpenseEntry[]
}

model Member {
  id         String   @id @default(uuid())
  divisionId String
  name       String
  position   String?
  photoUrl   String?
  email      String?
  phone      String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
}

model Project {
  id            String        @id @default(uuid())
  divisionId    String
  title         String
  description   String?
  status        ProjectStatus @default(PLANNED)
  startDate     DateTime?
  endDate       DateTime?
  coverPhotoUrl String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  division Division  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model Room {
  id          String   @id @default(uuid())
  name        String
  capacity    Int?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookingRooms BookingRoom[]
}

model Item {
  id          String   @id @default(uuid())
  name        String
  description String?
  quantity    Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookingItems BookingItem[]
}

model Booking {
  id                String        @id @default(uuid())
  requestedByUserId String
  divisionId        String
  projectId         String?
  purpose           String
  startAt           DateTime
  endAt             DateTime
  status            BookingStatus @default(PENDING)
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  requestedBy User      @relation("BookingRequester", fields: [requestedByUserId], references: [id])
  decidedBy   User?     @relation("BookingDecider", fields: [decidedByUserId], references: [id])
  division    Division  @relation(fields: [divisionId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id])

  bookingRooms BookingRoom[]
  bookingItems BookingItem[]

  @@index([startAt, endAt])
  @@index([status])
}

model BookingRoom {
  bookingId String
  roomId    String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([bookingId, roomId])
}

model BookingItem {
  bookingId String
  itemId    String
  quantity  Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([bookingId, itemId])
}

model FinanceCategory {
  id        String              @id @default(uuid())
  name      String
  type      FinanceCategoryType
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  incomeEntries  IncomeEntry[]
  expenseEntries ExpenseEntry[]
}

model IncomeEntry {
  id               String   @id @default(uuid())
  date             DateTime
  categoryId       String
  source           String?
  amount           Decimal  @db.Decimal(14, 2)
  note             String?
  recordedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category   FinanceCategory @relation(fields: [categoryId], references: [id])
  recordedBy User            @relation(fields: [recordedByUserId], references: [id])
}

model ExpenseEntry {
  id               String   @id @default(uuid())
  date             DateTime
  categoryId       String
  divisionId       String?
  amount           Decimal  @db.Decimal(14, 2)
  note             String?
  receiptUrl       String?
  recordedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category   FinanceCategory @relation(fields: [categoryId], references: [id])
  division   Division?       @relation(fields: [divisionId], references: [id])
  recordedBy User            @relation(fields: [recordedByUserId], references: [id])
}

model Budget {
  id         String   @id @default(uuid())
  divisionId String
  year       Int
  month      Int?
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([divisionId, year, month])
}

model LandingContent {
  id        String   @id @default(uuid())
  key       String   @unique
  valueId   String
  valueEn   String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
